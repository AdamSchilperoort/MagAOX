# Eye Doctor MagAO-X application
#
# INDI equivalent of:
#   dm_eye_doctor 7624 alpaoModes camsci 8 2...10 0.1 --skip 1
#
# Install as /opt/MagAOX/config/eyeDoctor.conf (or eyeDoc.conf if that is the
# process configName). Requires a running dmMode instance (alpaoModes, etc.).

[shmims]
shm_dm_flat = dm00disp00
shm_dm_sum = dm00disp
shm_cam = camsci

[camera]
cam_name = camsci

[eyedoctor]
modes_device = alpaoModes
# modes = 2...10,12
mode_start = 2
mode_end = 10
focus_mode_index = 2
core_radius = 8.0
search_range = 0.1
search_step = 0
n_steps = 20
n_repeats = 3
n_cluster = 5
n_cluster_repeat = 1
n_seq_repeat = 1
n_images = 3
skip_frames = 2
# cen_x = 255
# cen_y = 255
sat_thresh = 55000
blank_thresh = 0
dm_delay = 0.1
amp_tol = 0.001
amp_timeout = 10
search_kind = grid
baseline = true
randomize = true
ignore_focus = false
#flat_dir = /opt/MagAOX/calib/dm/bmc_1k/flats
flat_dir = /opt/MagAOX/calib/dm/alpao_bax735/flats
# dark_lib_path = /opt/MagAOX/data/darks/camsci
exptime_tol = 0.0001
